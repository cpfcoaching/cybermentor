# ─────────────────────────────────────────────────────
# CyberMentor — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────

# Google AI / Gemini
GEMINI_API_KEY=your_gemini_api_key_here
# Get yours at: https://aistudio.google.com/app/api-keys

# YouTube Data API v3 (Optional, for channel ingestion)
YOUTUBE_API_KEY=your_youtube_data_api_key_here

# Google Cloud (for Firestore + Cloud Run)
GOOGLE_CLOUD_PROJECT=your_gcp_project_id
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account-key.json
# Leave GOOGLE_APPLICATION_CREDENTIALS blank if running on Cloud Run (uses ADC)

# Firestore
FIRESTORE_DATABASE=(default)

# API Server
API_HOST=0.0.0.0
API_PORT=8080
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# App
APP_ENV=development   # development | production
